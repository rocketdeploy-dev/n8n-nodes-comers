{
	"name": "@comers/n8n-nodes-comers",
	"version": "0.2.0",
	"description": "Receive Comers domain events in n8n, with automatic subscription management",
	"license": "MIT",
	"homepage": "https://github.com/rocketdeploy-dev/n8n-nodes-comers",
	"keywords": [
		"n8n-community-node-package",
		"comers",
		"webhook",
		"trigger",
		"events"
	],
	"author": {
		"name": "Damian Nosowicz",
		"email": "damian@nzt.li"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rocketdeploy-dev/n8n-nodes-comers.git"
	},
	"bugs": {
		"url": "https://github.com/rocketdeploy-dev/n8n-nodes-comers/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"scan": "node scripts/scan-package.mjs",
		"pack:check": "node scripts/check-tarball.mjs",
		"check:tag": "node scripts/release-tag.mjs",
		"release": "node scripts/release.mjs",
		"prepublishOnly": "node scripts/prepublish.mjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ComersApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ComersTrigger/ComersTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.47.2",
		"@n8n/scan-community-package": "^0.35.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2",
		"vitest": "^4.1.9",
		"yaml": "^2.9.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"release-it": {
		"git": {
			"requireBranch": "main",
			"requireCleanWorkingDir": true,
			"requireUpstream": true,
			"requireCommits": true,
			"commit": true,
			"commitMessage": "chore: release ${version}",
			"tag": true,
			"tagName": "${version}",
			"tagAnnotation": "Release ${version}",
			"push": true
		},
		"npm": {
			"publish": false
		},
		"github": {
			"release": false
		},
		"hooks": {
			"before:init": [
				"node scripts/finalize-changelog.mjs --check",
				"npm run lint",
				"npm run build",
				"npm test",
				"npm run scan",
				"npm run pack:check"
			],
			"before:bump": "node scripts/finalize-changelog.mjs --check-version ${version}",
			"after:bump": "node scripts/finalize-changelog.mjs"
		}
	}
}
